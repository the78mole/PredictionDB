# Kopieren nach .env. Schlüssel braucht der Stack keine.

# Modellpaket: Ordner im Container (./models ist nach /models eingebunden) oder OCI-Referenz,
# z. B. ghcr.io/the78mole/predictiondb-models/de_lu:champion (sobald veröffentlicht)
PDB_PREDICT_MODEL=/models

# Image-Version (predict/vX.Y.Z -> X.Y.Z, X.Y oder latest)
PREDICT_TAG=latest
# Port und Adresse auf dem Host; 127.0.0.1 nur lokal
PREDICT_PORT=8080
PREDICT_BIND=0.0.0.0
# Eigentümer der Dateien in ./data (id -u, id -g)
PREDICT_UID=1000
PREDICT_GID=1000

# Zeitplan: stündlich um hh:20 UTC
PDB_PREDICT_EVERY_MIN=60
PDB_PREDICT_OFFSET_MIN=20
PDB_PREDICT_KEEP_DAYS=14
PDB_PREDICT_MODEL_REFRESH_H=24

# Optional: kostenloser EIA-Schlüssel spart den Download der Bulk-Dateien
PDB_EIA_API_KEY=

PDB_LOG_LEVEL=INFO
PDB_LOG_JSON=true
