# direnv: OpenBao-Zugang fuer PredictionDB, beschraenkt auf Namespace "it-infra".
#
# .env.bao (chmod 600, gitignored) enthaelt BAO_ADDR, BAO_NAMESPACE und BAO_TOKEN.
# Das Token sticht das Root-Token in ~/.vault-token und den Sperr-Riegel aus ~/GIT/.envrc.
# Bewusst KEIN source_up, sonst ueberschreibt der Riegel das Token wieder.

dotenv_if_exists .env.bao

env_vars_required BAO_ADDR BAO_NAMESPACE BAO_TOKEN
log_status "OpenBao: Namespace $BAO_NAMESPACE (secret/predictiondb)"
