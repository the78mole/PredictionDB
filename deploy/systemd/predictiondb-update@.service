# Auto-Update des Stacks (README, Abschnitt "Auto-Update des Stacks").
# Instanzname = Benutzer, dem der Checkout gehört und der in der Gruppe docker ist.
[Unit]
Description=PredictionDB: neuen Stand von main holen und ausrollen
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=/opt/predictiondb
ExecStart=/opt/predictiondb/scripts/vm-update.sh
TimeoutStartSec=30min
