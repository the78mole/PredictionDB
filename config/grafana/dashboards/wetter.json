    {
      "type": "barchart",
      "title": "Silber lokal je Monat (Anteil der GFS-Läufe)",
      "id": 46,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "description": "Je Monat der Anteil der erwarteten GFS-Läufe (ab v16, 22.03.2021 12Z, bis zum jüngsten veröffentlichten Lauf; Laufzeiten oben unter „GFS-Läufe“ wählbar), deren Silber vollständig in Garage wx-silver liegt. Grün = fertig, gelb = gerade im Download: im laufenden Import-Durchgang aus GHCR (wx-import) vorgesehen oder im Bronze-Backfill (gfs-backfill) in Arbeit. Läufe, die im NOAA-Archiv fehlen, bleiben offen, daher erreichen manche Monate keine 100 %.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "-- Erwartet: alle GFS-Läufe ab v16 (22.03.2021 12Z) bis zum jüngsten, der veröffentlicht sein sollte\n-- (NOAA ca. 3,5-5 h nach Laufzeit), nur die gewählten Laufzeiten. Grün: Silber liegt vollständig\n-- in wx-silver (meta.silver_run present). Gelb: im laufenden Import-Durchgang aus GHCR vorgesehen\n-- (loading, höchstens 12 h alt) oder gerade im Bronze-Download (meta.backfill_run running).\nWITH soll AS (\n  SELECT t FROM generate_series(timestamptz '2021-03-22 12:00+00',\n                                date_bin('6 hours', now() - interval '5 hours', timestamptz '2000-01-01'),\n                                interval '6 hours') t\n   WHERE extract(hour FROM t AT TIME ZONE 'UTC')::int::text IN ($gfs_lauf)),\ns AS (SELECT r.run_time, r.status, r.updated_at\n        FROM meta.silver_run r JOIN meta.source q USING (source_id)\n       WHERE q.code = 'gfs_0p25'),\nbronze AS (SELECT DISTINCT run_time FROM meta.backfill_run WHERE status = 'running'),\nz AS (\n  SELECT soll.t,\n         CASE WHEN s.status = 'present' THEN 'fertig'\n              WHEN s.status = 'loading' AND s.updated_at > now() - interval '12 hours' THEN 'laden'\n              WHEN bronze.run_time IS NOT NULL THEN 'laden' END AS zustand\n    FROM soll LEFT JOIN s ON s.run_time = soll.t LEFT JOIN bronze ON bronze.run_time = soll.t)\nSELECT to_char(t AT TIME ZONE 'UTC', 'YYYY-MM') AS \"Monat\",\n       round(100.0 * count(*) FILTER (WHERE zustand = 'fertig') / count(*), 1) AS \"Fertig\",\n       round(100.0 * count(*) FILTER (WHERE zustand = 'laden') / count(*), 1) AS \"Im Download\"\n  FROM z\n GROUP BY 1\n ORDER BY 1"
        }
      ],
