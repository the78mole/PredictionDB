    {
      "type": "table",
      "title": "GFS-Downloads: laufende Jobs",
      "id": 25,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "description": "Neu = neu geladene Läufe, Da = schon vorhanden, Unv. = unvollständig, Fehler = fehlgeschlagene Schritte. Zeitraum und Zuletzt in UTC, Start und Fertig ca. lokal.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT job_id AS \"Job\",\n       CASE mode WHEN 'live' THEN 'Live' ELSE 'Backfill' END AS \"Art\",\n       to_char(range_start AT TIME ZONE 'UTC', 'DD.MM.YY HH24\"Z\"') || ' – ' ||\n         to_char(range_end AT TIME ZONE 'UTC', 'DD.MM.YY HH24\"Z\"') AS \"Zeitraum\",\n       array_to_string(run_hours, '/') || 'Z' AS \"Läufe\",\n       round(100.0 * (n_complete + n_incomplete) / nullif(n_runs, 0), 1) AS \"Fortschritt\",\n       (n_complete + n_incomplete) || '/' || n_runs AS \"Bearbeitet\",\n       n_complete - n_skipped AS \"Neu\",\n       n_skipped AS \"Da\",\n       n_incomplete AS \"Unv.\",\n       n_failed_steps AS \"Fehler\",\n       bytes_stored AS \"Bronze\",\n       to_char(last_run AT TIME ZONE 'UTC', 'DD.MM.YY HH24\"Z\"') AS \"Zuletzt\",\n       to_char(started_at AT TIME ZONE 'Europe/Berlin', 'DD.MM. HH24:MI') AS \"Start\",\n       CASE WHEN mode = 'backfill' AND n_complete + n_incomplete > n_skipped\n            THEN to_char((now() + (now() - started_at) * (n_runs - n_complete - n_incomplete)\n                          / (n_complete + n_incomplete - n_skipped)) AT TIME ZONE 'Europe/Berlin',\n                         'DD.MM. HH24:MI') END AS \"Fertig ca.\",\n       CASE WHEN updated_at < now() - interval '30 minutes' THEN 'hängt?' ELSE 'läuft' END AS \"Status\"\n  FROM meta.backfill_job\n WHERE status = 'running'\n ORDER BY started_at DESC"
        }
      ],
