    {
      "type": "barchart",
      "title": "Gold lokal je Monat (Anteil der GFS-Läufe mit Wetter-Features)",
      "id": 47,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "description": "Je Monat der Anteil der erwarteten GFS-Läufe (wie beim Silber-Panel, Laufzeiten oben unter „GFS-Läufe“), für die die Wetter-Features je Cluster (Gold, feat.nwp_value) mit der aktuellen Clusterung und Feature-Version gerechnet sind. Grün = fertig, gelb = in Arbeit: Silber liegt lokal vor, Gold steht noch aus (wx-process-backfill rechnet stündlich nach, nur für die Laufzeiten in GFS_BACKFILL_RUNS). Eine neue Clusterung macht alle Läufe wieder gelb, bis sie neu gerechnet sind.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "-- Erwartete Läufe wie im Silber-Panel. Grün: meta.nwp_feature_run hat den Lauf für die aktuelle\n-- Clusterung (jüngste mit Gitter-Gewichten) und die zuletzt verwendete Feature-Version.\n-- Gelb: Silber liegt vor (meta.silver_run present), Gold fehlt noch.\nWITH soll AS (\n  SELECT t FROM generate_series(timestamptz '2021-03-22 12:00+00',\n                                date_bin('6 hours', now() - interval '5 hours', timestamptz '2000-01-01'),\n                                interval '6 hours') t\n   WHERE extract(hour FROM t AT TIME ZONE 'UTC')::int::text IN ($gfs_lauf)),\nq AS (SELECT source_id FROM meta.source WHERE code = 'gfs_0p25'),\ncl AS (SELECT c.clustering_version FROM assets.clustering c\n        WHERE EXISTS (SELECT 1 FROM assets.grid_weight w\n                       WHERE w.clustering_version = c.clustering_version AND w.grid = 'gfs_0p25')\n        ORDER BY c.created_at DESC LIMIT 1),\nfv AS (SELECT features_version FROM meta.nwp_feature_run\n        WHERE source_id = (SELECT source_id FROM q) ORDER BY processed_at DESC LIMIT 1),\ngold AS (SELECT f.run_time FROM meta.nwp_feature_run f\n          WHERE f.source_id = (SELECT source_id FROM q)\n            AND f.clustering_version = (SELECT clustering_version FROM cl)\n            AND f.features_version = (SELECT features_version FROM fv)),\nsilber AS (SELECT run_time FROM meta.silver_run\n            WHERE source_id = (SELECT source_id FROM q) AND status = 'present'),\nz AS (\n  SELECT soll.t,\n         CASE WHEN gold.run_time IS NOT NULL THEN 'fertig'\n              WHEN silber.run_time IS NOT NULL THEN 'arbeit' END AS zustand\n    FROM soll LEFT JOIN gold ON gold.run_time = soll.t LEFT JOIN silber ON silber.run_time = soll.t)\nSELECT to_char(t AT TIME ZONE 'UTC', 'YYYY-MM') AS \"Monat\",\n       round(100.0 * count(*) FILTER (WHERE zustand = 'fertig') / count(*), 1) AS \"Fertig\",\n       round(100.0 * count(*) FILTER (WHERE zustand = 'arbeit') / count(*), 1) AS \"In Arbeit\"\n  FROM z\n GROUP BY 1\n ORDER BY 1"
        }
      ],
