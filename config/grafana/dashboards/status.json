          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT day::timestamptz AS time, technology AS metric, sum(capacity_mw) / 1000 AS value\n  FROM assets.capacity_daily\n WHERE clustering_version = (SELECT max(clustering_version) FROM assets.capacity_daily)\n   AND $__timeFilter(day)\n GROUP BY 1, 2 ORDER BY 1"
        }
