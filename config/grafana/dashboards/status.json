    {
      "type": "table",
      "title": "GFS-Backfill: laufende Jobs",
      "id": 25,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "description": "wx-ingest gfs backfill (meta.backfill_job). Fortschritt = bearbeitete Läufe / Läufe im Zeitraum; 'Schon da' waren vorher vollständig. 'hängt?' = seit 30 min kein Lauf fertig.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT job_id AS \"Job\",\n       to_char(range_start AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') || ' – ' ||\n         to_char(range_end AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') AS \"Zeitraum\",\n       array_to_string(run_hours, '/') || 'Z' AS \"Läufe\",\n       round(100.0 * (n_complete + n_incomplete) / nullif(n_runs, 0), 1) AS \"Fortschritt\",\n       (n_complete + n_incomplete) || ' / ' || n_runs AS \"Bearbeitet\",\n       n_complete - n_skipped AS \"Neu geladen\",\n       n_skipped AS \"Schon da\",\n       n_incomplete AS \"Unvollständig\",\n       n_failed_steps AS \"Fehlerschritte\",\n       bytes_stored AS \"Bronze\",\n       to_char(last_run AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') AS \"Zuletzt\",\n       started_at AS \"Gestartet\",\n       CASE WHEN n_complete + n_incomplete > n_skipped\n            THEN now() + (now() - started_at) * (n_runs - n_complete - n_incomplete)\n                         / (n_complete + n_incomplete - n_skipped) END AS \"Voraussichtlich fertig\",\n       CASE WHEN updated_at < now() - interval '30 minutes' THEN 'hängt?' ELSE 'läuft' END AS \"Status\"\n  FROM meta.backfill_job\n WHERE status = 'running'\n ORDER BY started_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Fortschritt"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 99.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bronze"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "läuft": {
                        "color": "blue",
                        "index": 0
                      },
                      "fertig": {
                        "color": "green",
                        "index": 1
                      },
                      "hängt?": {
                        "color": "orange",
                        "index": 2
                      },
                      "abgebrochen": {
                        "color": "orange",
                        "index": 3
                      },
                      "Fehler": {
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
      "title": "GFS-Backfill: letzte 10 abgeschlossene Jobs",
      "id": 26,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "description": "Beendete Aufrufe von wx-ingest gfs backfill, neueste zuerst. 'abgebrochen' = gestoppt oder ohne Abschluss beendet.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT job_id AS \"Job\",\n       to_char(range_start AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') || ' – ' ||\n         to_char(range_end AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') AS \"Zeitraum\",\n       array_to_string(run_hours, '/') || 'Z' AS \"Läufe\",\n       round(100.0 * (n_complete + n_incomplete) / nullif(n_runs, 0), 1) AS \"Fortschritt\",\n       (n_complete + n_incomplete) || ' / ' || n_runs AS \"Bearbeitet\",\n       n_complete - n_skipped AS \"Neu geladen\",\n       n_skipped AS \"Schon da\",\n       n_incomplete AS \"Unvollständig\",\n       n_failed_steps AS \"Fehlerschritte\",\n       bytes_stored AS \"Bronze\",\n       to_char(last_run AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') AS \"Zuletzt\",\n       started_at AS \"Gestartet\",\n       finished_at AS \"Beendet\",\n       justify_interval(date_trunc('minute', finished_at - started_at))::text AS \"Dauer\",\n       CASE status WHEN 'done' THEN 'fertig' WHEN 'failed' THEN 'Fehler'\n                   ELSE 'abgebrochen' END AS \"Status\",\n       coalesce(error, '') AS \"Meldung\"\n  FROM meta.backfill_job\n WHERE status <> 'running'\n ORDER BY finished_at DESC NULLS LAST\n LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
