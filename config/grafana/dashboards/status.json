    {
      "type": "table",
      "title": "GFS-Backfill: zuletzt abgeschlossene Läufe",
      "id": 28,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "description": "Die letzten 50 abgeschlossenen Läufe aller Jobs, neueste oben.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(r.run_time AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24\"Z\"') AS \"Lauf\",\n       CASE r.status WHEN 'complete' THEN 'geladen' WHEN 'skipped' THEN 'schon da'\n                     WHEN 'incomplete' THEN 'unvollständig' ELSE 'abgebrochen' END AS \"Ergebnis\",\n       r.steps_stored AS \"Schritte neu\",\n       r.steps_failed AS \"Fehler\",\n       r.bytes_stored AS \"Bronze\",\n       justify_interval(date_trunc('second', r.finished_at - r.started_at))::text AS \"Dauer\",\n       r.finished_at AS \"Fertig\",\n       r.job_id AS \"Job\"\n  FROM meta.backfill_run r\n WHERE r.finished_at IS NOT NULL\n ORDER BY r.finished_at DESC\n LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bronze"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
