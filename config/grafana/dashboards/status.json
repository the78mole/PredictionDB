{
  "uid": "pdb-status",
  "title": "PredictionDB Status",
  "tags": [
    "predictiondb"
  ],
  "timezone": "",
  "schemaVersion": 41,
  "version": 3,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Energiedaten",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Energiedaten je Quelle",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.code AS \"Quelle\",\n       count(DISTINCT f.dataset) AS \"Datensätze\",\n       min(f.chunk_start) AS \"Backfill bis\",\n       max(f.chunk_end) AS \"Abgedeckt bis\",\n       sum(f.n_values) AS \"Werte geladen\",\n       max(f.fetched_at) AS \"Letzter Abruf\"\n  FROM meta.energy_fetch f JOIN meta.source s USING (source_id)\n GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Aus meta.energy_fetch: jeder geladene Abschnitt je Quelle und Datensatz.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Werte geladen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Backfill seit 2015",
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.code AS \"Quelle\",\n       round((100 * extract(epoch FROM now() - min(f.chunk_start))\n                  / extract(epoch FROM now() - timestamptz '2015-01-01'))::numeric, 1) AS \"Fortschritt\"\n  FROM meta.energy_fetch f JOIN meta.source s USING (source_id)\n GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Anteil der Zeitspanne 2015 bis heute, die der Backfill je Quelle schon erreicht hat.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Geladene Werte je Stunde",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 hour', f.fetched_at) AS time, s.code AS metric, sum(f.n_values) AS value\n  FROM meta.energy_fetch f JOIN meta.source s USING (source_id)\n WHERE $__timeFilter(f.fetched_at)\n GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Day-Ahead-Preis DE-LU und Last (beste Quelle)",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, code AS metric, value\n  FROM energy.value_best\n WHERE code IN ('da_price_de_lu', 'load_actual') AND $__timeFilter(ts)\n ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "da_price_de_lu"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Preis €/MWh"
              },
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "load_actual"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Last MW"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
