          "rawSql": "SELECT export_date AS \"Export\", version AS \"Release\", status AS \"Status\",\n       n_units AS \"Einheiten\", size_bytes AS \"ZIP\", updated_at AS \"Stand\"\n  FROM assets.snapshot ORDER BY export_date DESC"
