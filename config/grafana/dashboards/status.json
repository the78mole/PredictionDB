    {
      "type": "table",
      "title": "Letzte verarbeitete GFS-Läufe",
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 8,
