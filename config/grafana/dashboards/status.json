    {
      "type": "table",
      "title": "Energiedaten je Quelle",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH ds AS (\n  SELECT source_id, dataset, min(chunk_start) AS erster\n    FROM meta.energy_fetch GROUP BY 1, 2)\nSELECT s.code AS \"Quelle\",\n       count(DISTINCT f.dataset) AS \"Datensätze\",\n       (SELECT max(erster) FROM ds WHERE ds.source_id = s.source_id) AS \"Alle Datensätze ab\",\n       min(f.chunk_start) AS \"Weitester Datensatz ab\",\n       max(f.chunk_end) AS \"Abgedeckt bis\",\n       sum(f.n_values) AS \"Werte geladen\",\n       max(f.fetched_at) AS \"Letzter Abruf\"\n  FROM meta.energy_fetch f JOIN meta.source s USING (source_id)\n GROUP BY s.source_id, s.code ORDER BY 1"
        }
      ],
      "description": "Aus meta.energy_fetch. Der Backfill arbeitet sich Datensatz für Datensatz zurück: „Alle Datensätze ab“ ist der Stand des langsamsten, „Weitester“ der des schnellsten.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Werte geladen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Backfill seit 2015",
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH ds AS (\n  SELECT source_id, dataset, min(chunk_start) AS erster\n    FROM meta.energy_fetch GROUP BY 1, 2)\nSELECT s.code AS \"Quelle\",\n       round((100 * avg(extract(epoch FROM now() - ds.erster)\n                        / extract(epoch FROM now() - timestamptz '2015-01-01')))::numeric, 1) AS \"Fortschritt\"\n  FROM ds JOIN meta.source s USING (source_id)\n GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Mittel über alle Datensätze einer Quelle: Anteil der Zeitspanne 2015 bis heute, die schon geladen ist.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Geladene Werte je Stunde",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 hour', f.fetched_at) AS time, s.code AS metric, sum(f.n_values) AS value\n  FROM meta.energy_fetch f JOIN meta.source s USING (source_id)\n WHERE $__timeFilter(f.fetched_at)\n GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
