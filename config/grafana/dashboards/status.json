          "rawSql": "SELECT to_char(run_time AT TIME ZONE 'UTC', 'DD.MM.YYYY HH24:MI \"UTC\"') AS \"Lauf\",\n       clustering_version AS \"Clusterung\", features_version AS \"Features\",\n       n_values AS \"Werte\", processed_at AS \"Verarbeitet\"\n  FROM meta.nwp_feature_run\n ORDER BY run_time DESC LIMIT 12"
        }
