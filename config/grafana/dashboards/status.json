    {
      "type": "stat",
      "title": "Neuester verarbeiteter Lauf",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pdb-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pdb-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT max(run_time) AS \"Lauf\" FROM meta.nwp_feature_run"
        }
      ],
      "description": "Aus meta.nwp_feature_run (wx-process). Bronze-Downloads selbst stehen nur im Log von ingest-gfs.",
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Alter des neuesten Laufs",
