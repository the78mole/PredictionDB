          "rawSql": "SELECT hypertable_schema || '.' || hypertable_name AS \"Tabelle\",\n       hypertable_size(format('%I.%I', hypertable_schema, hypertable_name)::regclass) AS \"Größe\",\n       (SELECT count(*) FROM timescaledb_information.chunks c\n         WHERE c.hypertable_schema = h.hypertable_schema AND c.hypertable_name = h.hypertable_name\n           AND c.is_compressed) AS \"komprimierte Chunks\",\n       (SELECT count(*) FROM timescaledb_information.chunks c\n         WHERE c.hypertable_schema = h.hypertable_schema AND c.hypertable_name = h.hypertable_name) AS \"Chunks\"\n  FROM timescaledb_information.hypertables h\n ORDER BY 2 DESC"
