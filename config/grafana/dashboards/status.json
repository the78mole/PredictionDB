          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "läuft": {
                        "color": "blue",
                        "index": 0
                      },
                      "fertig": {
                        "color": "green",
                        "index": 1
                      },
                      "hängt?": {
