    {
      "type": "bargauge",
      "title": "Belegung der Partitionen",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "pdb-prometheus"
      },
      "description": "Dateisysteme der VM (node-exporter): System = Root-Partition (scsi0), Daten = /var/lib/docker (scsi1) mit allen Docker-Volumes, also Postgres/TimescaleDB, Garage S3, Prometheus, Grafana und ML. Belegt wie bei df (ohne für root reservierte Blöcke); Frei = für Dienste verfügbar.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdb-prometheus"
          },
          "expr": "100 * (node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"} - node_filesystem_free_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"}) / ((node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"} - node_filesystem_free_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"}) + node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"})",
          "legendFormat": "{{mountpoint}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "System (/)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/var/lib/docker"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Daten (/var/lib/docker)"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "type": "table",
      "title": "Partitionen",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "pdb-prometheus"
      },
      "description": "Dateisysteme der VM (node-exporter): System = Root-Partition (scsi0), Daten = /var/lib/docker (scsi1) mit allen Docker-Volumes, also Postgres/TimescaleDB, Garage S3, Prometheus, Grafana und ML. Belegt wie bei df (ohne für root reservierte Blöcke); Frei = für Dienste verfügbar.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdb-prometheus"
          },
          "expr": "max by (mountpoint, device, fstype) (node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pdb-prometheus"
          },
          "expr": "max by (mountpoint, device, fstype) ((node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"} - node_filesystem_free_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|devtmpfs|overlay|squashfs|nsfs|autofs|fuse.*\",mountpoint!~\"/boot.*\"}))",
          "instant": true,
