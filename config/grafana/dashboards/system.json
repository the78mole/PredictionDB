    {
      "type": "timeseries",
      "title": "Netzwerk der VM",
      "id": 29,
      "datasource": {
        "type": "prometheus",
        "uid": "pdb-prometheus"
      },
      "description": "Host-Schnittstellen der VM (cAdvisor, Root-Cgroup): eth0 = LAN/Internet, eth1 = Proxy-Netz. Empfangen nach oben, gesendet nach unten.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdb-prometheus"
          },
          "expr": "sum by (interface) (rate(container_network_receive_bytes_total{id=\"/\",interface=~\"eth.*\"}[2m]))",
          "legendFormat": "{{interface}} empfangen",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pdb-prometheus"
          },
          "expr": "sum by (interface) (rate(container_network_transmit_bytes_total{id=\"/\",interface=~\"eth.*\"}[2m]))",
          "legendFormat": "{{interface}} gesendet",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 15,
            "axisLabel": "",
            "axisCenteredZero": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(gesendet|schreiben)$"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
