# Kopieren nach .env und Geheimnisse ersetzen. .env nie committen.

# PostgreSQL / TimescaleDB
POSTGRES_USER=predictiondb
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=predictiondb
# Für Werkzeuge außerhalb von Compose (alembic, pytest); in Compose wird die URL gesetzt.
PDB_DATABASE_URL=postgresql+psycopg://predictiondb:bitte-aendern@localhost:5432/predictiondb

# Garage (Single Node). Erzeugen mit: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
PDB_GARAGE_CAPACITY=400G

# S3-Zugang der Dienste. Key-ID: "GK" + 24 Hex-Zeichen (echo GK$(openssl rand -hex 12)),
# Secret: 64 Hex-Zeichen (openssl rand -hex 32). garage-init importiert den Schlüssel.
PDB_S3_ENDPOINT_URL=http://localhost:3900
PDB_S3_REGION=garage
PDB_S3_ACCESS_KEY_ID=
PDB_S3_SECRET_ACCESS_KEY=

# Energiedaten (services/energy_ingest). Standard sind nur freie Quellen (SMARD, eigene
# Marktwerte). Unfreie Quellen schränken die Weitergabe ein (docs/ARCHITEKTUR.md 7.11.1) und
# laufen nur mit Freigabe; auf der VM bleiben sie aus.
PDB_ALLOW_ENTSO_E=false
PDB_ALLOW_ENERGY_CHARTS=false
PDB_ALLOW_NETZTRANSPARENZ=false
# ENTSO-E-Token (nur mit PDB_ALLOW_ENTSO_E=true): Registrierung auf transparency.entsoe.eu,
# dann Mail an transparency@entsoe.eu, Betreff "Restful API access".
PDB_ENTSOE_TOKEN=
# Netztransparenz (amtliche Marktwerte, nur mit PDB_ALLOW_NETZTRANSPARENZ=true): Client im
# API-Portal api-portal.netztransparenz.de
PDB_NETZTRANSPARENZ_CLIENT_ID=
PDB_NETZTRANSPARENZ_CLIENT_SECRET=
# PDB_ENERGY_SOURCES=["entsoe","smard","energy_charts","netztransparenz","pdb_marktwert"]
# PDB_ENERGY_BACKFILL_FROM=2015-01-01T00:00:00Z
# Blöcke Historie je 15-min-Zyklus (Standard 6; 48 holt die Historie seit 2015 in etwa einem Tag)
# PDB_ENERGY_BACKFILL_CHUNKS_PER_CYCLE=48

# MaStR-Import (services/mastr_ingest); Arbeitsverzeichnis braucht einige GB für das ZIP
#PDB_MASTR_CONFIG=config/sources/mastr.yaml
#PDB_MASTR_WORK_DIR=/tmp/mastr

# Wetter-Verarbeitung (services/wx_process)
#PDB_WX_PROCESS_CONFIG=config/process/gfs_0p25.yaml

# Grafana (config/grafana). Passwörter erzeugen mit: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=
PDB_GRAFANA_DB_PASSWORD=
#GRAFANA_ROOT_URL=https://predb.intern.chaintronics.com/
#GRAFANA_ANONYMOUS=false

PDB_LOG_LEVEL=INFO
PDB_LOG_JSON=true

# Image-Tag der Python-Dienste: latest = jüngster grüner Stand von main aus GHCR.
# Auf der VM mit Auto-Update (scripts/vm-update.sh) TAG=deployed setzen.
# TAG=latest
