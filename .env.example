# Kopieren nach .env und Geheimnisse ersetzen. .env nie committen.

# PostgreSQL / TimescaleDB
POSTGRES_USER=predictiondb
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=predictiondb
# Für Werkzeuge außerhalb von Compose (alembic, pytest); in Compose wird die URL gesetzt.
PDB_DATABASE_URL=postgresql+psycopg://predictiondb:bitte-aendern@localhost:5432/predictiondb

# Garage (Single Node). Erzeugen mit: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
PDB_GARAGE_CAPACITY=400G

# S3-Zugang der Dienste. Key-ID: "GK" + 24 Hex-Zeichen (echo GK$(openssl rand -hex 12)),
# Secret: 64 Hex-Zeichen (openssl rand -hex 32). garage-init importiert den Schlüssel.
PDB_S3_ENDPOINT_URL=http://localhost:3900
PDB_S3_REGION=garage
PDB_S3_ACCESS_KEY_ID=
PDB_S3_SECRET_ACCESS_KEY=

# Energiedaten (services/energy_ingest). Standard sind nur freie Quellen (SMARD, eigene
# Marktwerte). Unfreie Quellen schränken die Weitergabe ein (docs/ARCHITEKTUR.md 7.11.1) und
# laufen nur mit Freigabe; auf der VM bleiben sie aus.
PDB_ALLOW_ENTSO_E=false
PDB_ALLOW_NETZTRANSPARENZ=false
# Brennstoffpreise: Thomson-Reuters-Reihen der EIA (Brent, WTI, Benzin, Heizöl, Propan,
# Henry Hub) und THE-Gaspreise (VTP) sind urheberrechtlich geschützt
PDB_ALLOW_EIA_REUTERS=false
PDB_ALLOW_THE=false
# ENTSO-E-Token: mit Token läuft die freie Lastprognose (entsoe_last); Preis, Last und
# Erzeugung zusätzlich nur mit PDB_ALLOW_ENTSO_E=true. Registrierung auf transparency.entsoe.eu,
# dann Mail an transparency@entsoe.eu, Betreff "Restful API access".
PDB_ENTSOE_TOKEN=
# Netztransparenz (amtliche Marktwerte, nur mit PDB_ALLOW_NETZTRANSPARENZ=true): Client im
# API-Portal api-portal.netztransparenz.de
PDB_NETZTRANSPARENZ_CLIENT_ID=
PDB_NETZTRANSPARENZ_CLIENT_SECRET=
# EIA-API-Schlüssel (kostenlos, eia.gov/opendata/register.php); ohne Schlüssel lädt
# energy-ingest die Bulk-Dateien PET.zip/NG.zip (rund 60 MB, alle 6 h)
PDB_EIA_API_KEY=
# GIE-Schlüssel für AGSI+ (Gasspeicher) und ALSI (LNG) je Gastag, kostenlos unter
# agsi.gie.eu/account; ohne Schlüssel bleiben gie_agsi/gie_alsi aus, Eurostat läuft trotzdem
PDB_GIE_API_KEY=
# Download-Adressen mit Dokument-ID; ändern sie sich, meldet Grafana "Reihe veraltet"
#PDB_ENERGY_WORLDBANK_URL=https://thedocs.worldbank.org/en/doc/74e8be41ceb20fa0da750cda2f6b9e4e-0050012026/related/CMO-Historical-Data-Monthly.xlsx
#PDB_ENERGY_OIL_BULLETIN_URL=https://energy.ec.europa.eu/document/download/906e60ca-8b6a-44e7-8589-652854d2fd3f_en?filename=Weekly_Oil_Bulletin_Prices_History_maticni_4web.xlsx
# PDB_ENERGY_SOURCES=["smard","pdb_marktwert","eia","eia_reuters","ecb","worldbank","oil_bulletin","the","gie_agsi","gie_alsi","eurostat"]
# PDB_ENERGY_BACKFILL_FROM=2015-01-01T00:00:00Z
# Blöcke Historie je 15-min-Zyklus (Standard 6; 48 holt die Historie seit 2015 in etwa einem Tag)
# PDB_ENERGY_BACKFILL_CHUNKS_PER_CYCLE=48

# MaStR-Import (services/mastr_ingest); Arbeitsverzeichnis braucht einige GB für das ZIP
#PDB_MASTR_CONFIG=config/sources/mastr.yaml
#PDB_MASTR_WORK_DIR=/tmp/mastr

# Wetter-Verarbeitung (services/wx_process)
#PDB_WX_PROCESS_CONFIG=config/process/gfs_0p25.yaml

# GFS-Historie (compose.yaml, Profile backfill und history; services/wx_exchange)
#GFS_BACKFILL_START=2021-03-22T12
# Beginn für wx-import und wx-process-backfill (Standard GFS_BACKFILL_START); früher als
# 2021-03-22T12 für die Läufe vor GFS v16 aus NCAR GDEX, z. B. 2019-06-12T12 (Pilot v15)
#GFS_HISTORY_START=2021-03-22T12
# Laufzeiten für gfs-backfill und wx-process-backfill
#GFS_BACKFILL_RUNS=0,12
# Bronze auch für Läufe laden, deren Silber schon aus GHCR importiert ist (Standard aus)
#GFS_BACKFILL_BRONZE=false
# Laufzeiten, die wx-import aus GHCR holt, in Reihenfolge der Priorität
#GFS_HISTORY_RUNS=0,12,6,18
# Quelle des Silber-Imports (anonym lesbar, wenn das Paket öffentlich ist)
#WX_EXCHANGE_REPOSITORY=the78mole/predictiondb-data/gfs-0p25-silver

# Grafana (config/grafana). Passwörter erzeugen mit: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=
PDB_GRAFANA_DB_PASSWORD=
#GRAFANA_ROOT_URL=https://predb.intern.chaintronics.com/
#GRAFANA_ANONYMOUS=false
# Alarm-E-Mails (Formatänderung, anhaltende Abruffehler, veraltete Reihen). Host mit Port,
# z. B. smtp.example.org:587; STARTTLS-Richtlinie: MandatoryStartTLS, OpportunisticStartTLS
# oder NoStartTLS (Port 465 mit TLS: NoStartTLS)
PDB_SMTP_HOST=
PDB_SMTP_USER=
PDB_SMTP_PASSWORD=
#PDB_SMTP_FROM=
#PDB_SMTP_STARTTLS=MandatoryStartTLS
PDB_ALERT_EMAIL=

PDB_LOG_LEVEL=INFO
PDB_LOG_JSON=true

# Image-Tag der Python-Dienste: latest = jüngster grüner Stand von main aus GHCR.
# Auf der VM mit Auto-Update (scripts/vm-update.sh) TAG=deployed setzen.
# TAG=latest
